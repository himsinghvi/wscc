# ---- Supabase (Postgres + Auth + RLS) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key               # safe for browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role   # BACKEND ONLY — never expose
SUPABASE_JWT_SECRET=your-jwt-secret           # for verifying user JWTs (or use JWKS)

# ---- Azure OpenAI (AI scheduler) ----
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o                # your deployment name

# ---- App behaviour ----
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173
ENV=development

# ---- Frontend (Vite needs VITE_ prefix) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Same-origin API. Keep as /api for single-port local + Vercel.
VITE_API_BASE_URL=/api
